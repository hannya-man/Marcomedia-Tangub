{
    "$schema": "https://openapi.vercel.sh/vercel.json",
    "framework": null,
    "installCommand": "echo \"Composer packages are installed by the PHP runtime\"",
    "buildCommand": "echo \"CSS and JS are already built in public/build (npm run build)\"",
    "outputDirectory": "public",
    "functions": {
        "api/index.php": {
            "runtime": "vercel-php@0.8.0",
            "maxDuration": 30
        }
    },
    "routes": [
        { "src": "/build/(.*)", "headers": { "cache-control": "public, max-age=31536000, immutable" }, "dest": "/build/$1" },
        { "src": "/(images|icons)/(.*)", "dest": "/$1/$2" },
        { "src": "/(favicon\\.ico|robots\\.txt|manifest\\.json|sw\\.js)", "dest": "/$1" },
        { "src": "/(.*)", "dest": "/api/index.php" }
    ]
}
