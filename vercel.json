{
    "$schema": "https://openapi.vercel.sh/vercel.json",
    "framework": null,
    "installCommand": "echo \"Composer packages are installed by the PHP runtime\"",
    "buildCommand": "echo \"The CSS is already built in public/css (npm run build)\"",
    "outputDirectory": "public",
    "regions": ["bom1"],
    "functions": {
        "api/index.php": {
            "runtime": "vercel-php@0.8.0",
            "maxDuration": 30
        }
    },
    "routes": [
        { "src": "/(css|images|icons)/(.*)", "dest": "/$1/$2" },
        { "src": "/(favicon\\.ico|robots\\.txt|manifest\\.json|sw\\.js)", "dest": "/$1" },
        { "src": "/(.*)", "dest": "/api/index.php" }
    ]
}
